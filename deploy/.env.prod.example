# Copy to deploy/.env.prod (local, gitignored). ./scripts/deploy.sh syncs it to the VM.
# Never commit .env.prod. Compose on the VM reads it via --env-file.

# Postgres — same server as Angi, separate database + role (created once on VM)
READ_DB_USER=read
READ_DB_NAME=read
READ_DB_PASSWORD=change-me-strong-db-password

# CORS — web + Expo; native apps usually omit Origin
CORS_ORIGINS=https://read-api.antunai.com,http://localhost:3000,http://localhost:8081

SEED_DEMO=false

# Auth — production Firebase (mount ./firebase-service-account.json via compose)
AUTH_DEV_MODE=false
AUTH_DEV_SECRET=
ADMIN_EMAILS=admin@read.app
FIREBASE_PROJECT_ID=read-99d4d
FIREBASE_CREDENTIALS_JSON=/run/secrets/firebase.json

# Google Cloud TTS (uses VM / workload ADC when enabled)
GOOGLE_TTS_ENABLED=false
GOOGLE_TTS_ENGINE=neural2
GOOGLE_TTS_GENDER=male

# Optional Gemini
AI_EXPLAIN_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Knowledge Hub ingest. Leave empty to disable (API returns 503).
HUB_SYNC_TOKEN=

# Image tag (local build default)
API_IMAGE=read-api:latest
