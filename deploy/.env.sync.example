# Copy to deploy/.env.sync (gitignored) and fill secrets.
# Used by scripts/sync-*.sh for local ↔ cloud data sync.

# SSH host from ~/.ssh/config (angi-vm → vstock-api)
SSH_HOST=angi-vm

# Cloud Postgres is bound to VM localhost only (shared Angi Postgres container).
# Tunnel: Mac LOCAL_PORT → VM 127.0.0.1:5432
LOCAL_TUNNEL_PORT=15432

# Cloud DB (role/db created on the shared Postgres for Read)
CLOUD_DB_USER=read
CLOUD_DB_NAME=read
CLOUD_DB_PASSWORD=change-me-same-as-deploy-env-prod

# Local Docker Compose Postgres (docker compose up -d db)
LOCAL_DB_CONTAINER=read-db-1
LOCAL_DB_USER=read
LOCAL_DB_NAME=read

# Cloud Docker
CLOUD_PG_CONTAINER=deploy-postgres-1
CLOUD_API_CONTAINER=read-api

# Paths (relative to repo root unless absolute)
LOCAL_UPLOADS_DIR=uploads
CLOUD_UPLOADS_PATH=/data/uploads
