{
  "expo": {
    "name": "Read",
    "slug": "read",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "read",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#d5e2dd"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nguyendinhanh.read"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#d5e2dd"
      },
      "package": "com.nguyendinhanh.read"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Read to choose a book cover from your photo library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8000"
    }
  }
}
