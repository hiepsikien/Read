{
  "expo": {
    "name": "Read",
    "slug": "read",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "read",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.read.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#d5e2dd"
      },
      "package": "app.read.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8000"
    }
  }
}
