# FastAPI URL. Use your computer's LAN IP on a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Firebase Console > Project settings > Your apps > Web app > firebaseConfig
# These client values are public identifiers, not service-account secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=replace-with-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace-with-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=replace-with-web-app-id
