DATABASE_URL=postgresql+psycopg://read:read@localhost:5433/read
UPLOAD_DIR=../../uploads
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081
SEED_DEMO=true
AUTH_DEV_MODE=true
AUTH_DEV_SECRET=read-dev-firebase-standin-secret-change-me
ADMIN_EMAILS=admin@read.app

# Production Firebase Auth:
# 1. Set AUTH_DEV_MODE=false.
# 2. Download a service-account JSON and save it as
#    apps/api/firebase-service-account.json (ignored by Git).
# 3. Replace the project ID below.
#
# Never put these server credentials in EXPO_PUBLIC_* variables.
FIREBASE_PROJECT_ID=replace-with-project-id
FIREBASE_CREDENTIALS_JSON=./firebase-service-account.json

# Google Cloud TTS uses Application Default Credentials. For local development:
# gcloud auth application-default login
# gcloud auth application-default set-quota-project read-504007
GOOGLE_TTS_ENABLED=false
# Choose by engine + gender (preferred).
# Engines: standard | wavenet | neural2 | chirp3
# Genders: male | female
GOOGLE_TTS_ENGINE=neural2
GOOGLE_TTS_GENDER=male
# Optional Chirp3 persona override, e.g. Charon / Kore / Fenrir / Aoede
# GOOGLE_TTS_CHIRP_PERSONA=Charon
# Optional hard override. When set, ignores ENGINE/GENDER.
# GOOGLE_TTS_VOICE=vi-VN-Neural2-D
# TTS_CACHE_DIR=../../uploads/tts-cache
# Compare voices locally: GET /api/tts/compare
