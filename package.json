{
  "name": "read",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:web": "npm run dev -w apps/web",
    "dev:mobile": "npm --prefix apps/mobile start",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "brand:build": "node scripts/brand/build.mjs",
    "start": "npm run start -w apps/web",
    "api:install": "python3 -m venv apps/api/.venv && apps/api/.venv/bin/pip install -r apps/api/requirements.txt",
    "api:dev": "cd apps/api && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "api:test": "cd apps/api && .venv/bin/pytest -q",
    "db:up": "docker compose up -d db",
    "sync:status": "scripts/sync-db.sh status && scripts/sync-uploads.sh status",
    "sync:to-cloud": "scripts/sync-to-cloud.sh",
    "sync:from-cloud": "scripts/sync-from-cloud.sh"
  }
}
